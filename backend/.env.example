# SQLite by default so the API runs with zero external infra during development.
# Swap to a managed PostgreSQL connection string before going to production.
DATABASE_URL="file:./dev.db"

PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Card processor (e.g. Stripe/Areeba/NCB gateway). Sandbox keys only — never commit real secrets.
CARD_GATEWAY_API_KEY="sk_test_placeholder"

# Wish Money and OMT do not expose public developer APIs today; integration requires a direct
# commercial/technical agreement with each network. These are placeholders for that future
# credential set so the adapter layer has somewhere real to plug in.
WISH_MONEY_API_KEY="placeholder"
WISH_MONEY_API_BASE_URL="https://sandbox.wishmoney.example/api"
OMT_API_KEY="placeholder"
OMT_API_BASE_URL="https://sandbox.omtonline.example/api"
